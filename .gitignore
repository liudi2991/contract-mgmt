# ======================================================================
# 合同回款管理系统 · .gitignore
# ======================================================================

# ---- 环境变量与密钥（绝对不能进库）----
.env
.env.local
.env.*.local
**/.env
!.env.example
**/application-local.yml
**/application-prod.yml
*.pem
*.key
*.p12
*.jks
*.keystore

# ---- 操作系统 ----
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- IDE / 编辑器 ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
!.vscode/settings.recommended.json
.fleet/
.cursor/
*.swp
*.swo
*~
nbproject/private/
.classpath
.project
.settings/
.factorypath

# ---- 日志与临时 ----
*.log
logs/
log/
tmp/
.tmp/
*.pid
*.seed
*.tgz

# ======================================================================
# 后端 / Java / Maven
# ======================================================================
backend/target/
backend/build/
backend/out/
**/target/
*.class
*.war
*.ear
hs_err_pid*.log
replay_pid*.log

# 保留 Maven Wrapper（jar 是必需的，没了 ./mvnw 跑不起来）
!backend/.mvn/wrapper/maven-wrapper.jar

# ======================================================================
# 前端 / Node / Vite
# ======================================================================
frontend/node_modules/
**/node_modules/
frontend/dist/
**/dist/
frontend/.vite/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
.eslintcache
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.output/
.svelte-kit/
.vercel/
.netlify/

# 前端自动生成的类型声明（unplugin-auto-import / unplugin-vue-components）
frontend/auto-imports.d.ts
frontend/components.d.ts

# ======================================================================
# 部署运行时产物（云主机 ops/install.sh 会生成的目录，本地不应入库）
# ======================================================================
ops/data/
ops/logs/
ops/backup/
ops/config/.env
ops/templates/.env.rendered
*.rendered

# 升级 / 备份临时
**/backup/upgrade/
**/heapdump.hprof
core.*

# ======================================================================
# 其它
# ======================================================================
*.bak
*.bak.*
*.orig
*.rej
.python-version
__pycache__/
*.pyc
coverage/
.coverage
htmlcov/
